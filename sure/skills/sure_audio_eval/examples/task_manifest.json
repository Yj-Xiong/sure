{
  "schema": "sure.audio_eval.task_manifest.v1",
  "task_id": "speech-quality-example-v1",
  "task_version": "v1",
  "dataset_version": "dataset-v1",
  "engine_task": "se",
  "sample_ids": ["sample_0001", "sample_0002"],
  "candidate_keys": ["hidden_reference", "unprocessed", "model_a", "model_b"],
  "candidate_roles": {"hidden_reference": "hidden_reference", "unprocessed": "unprocessed", "model_a": "model", "model_b": "model"},
  "scale": {"min": 0, "max": 100, "step": 1, "dimension": "overall_quality"},
  "analysis_unit": "model_condition",
  "excluded_candidates_from_correlation": ["hidden_reference", "unprocessed"],
  "metric_policies": {
    "pesq": {"direction": "higher_better", "type": "intrusive", "reference_mode": "paired", "matching_reference_required": true},
    "dnsmos": {"direction": "higher_better", "type": "non_intrusive", "reference_mode": "none", "matching_reference_required": false}
  },
  "audio_policy": {
    "audio_version": "audio-v1",
    "sample_rate": 16000,
    "channels": 1,
    "duration_seconds": 8,
    "loudness_standard": "ITU-R BS.1770",
    "true_peak_max_dbTP": -1
  },
  "interface_contract": {
    "schema": "sure.audio_eval.interface_contract.v1",
    "evaluation_kind": "speech_enhancement",
    "leaderboard": {"mode": "create", "leaderboard_id": null, "publish_policy": "after_settlement"},
    "visibility": {
      "initiator_note_visible_to_rater": false,
      "rater_instruction_required": true,
      "reference_audio_explanation_visible_to_rater": false
    },
    "sample_source": {"mode": "auto", "source_id": "dataset-v1", "package_path": null, "selection_policy": "fixed_dataset"},
    "audio_pairing": {"relation": "clean_noisy_processed", "processing_stage": "dataset"},
    "model_targets": {"management": "leaderboard_models", "allow_remove": true, "allow_custom": false},
    "scoring": {
      "metric_configuration_source": "task_manifest.metric_policies",
      "scale_source": "task_manifest.scale",
      "reference_validation": {"enabled": true, "rule_version": "harness.reference_score.v1"},
      "aggregation": "arithmetic_mean"
    },
    "submission": {"batch_mode": "single_task", "completion_policy": "all_declared_candidates", "allow_partial": false},
    "delivery": {"mobile_compatible": true, "shareable_entry": true, "interruption": "resume", "progress_controls": ["pause", "cancel", "restart"]}
  },
  "standards": ["ITU-T P.1401", "ITU-R BS.1770", "ETSI TS 103 281"]
}
