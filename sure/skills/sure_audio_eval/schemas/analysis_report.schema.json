{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "correlation_unit", "correlations", "screening", "status"],
  "properties": {
    "schema": {"type": "string", "enum": ["sure.audio_eval.analysis.v1"]},
    "task_id": {"type": "string"},
    "task_version": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "audio_version": {"type": ["string", "null"]},
    "correlation_unit": {"type": "string", "enum": ["model_condition"]},
    "model_candidates": {"type": "array", "items": {"type": "string"}},
    "excluded_candidates": {"type": "array", "items": {"type": "string"}},
    "metric_plan": {"type": "array", "items": {"type": "object"}},
    "correlations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["metric", "screening", "n", "model_count", "pearson", "spearman", "metric_type", "direction", "reference_mode"],
        "properties": {
          "metric": {"type": "string"},
          "screening": {"type": "string", "enum": ["before", "after"]},
          "n": {"type": "integer", "minimum": 0},
          "model_count": {"type": "integer", "minimum": 0},
          "pearson": {"type": ["number", "null"]},
          "spearman": {"type": ["number", "null"]},
          "metric_type": {"type": ["string", "null"]},
          "direction": {"type": ["string", "null"]},
          "reference_mode": {"type": ["string", "null"]}
        }
      }
    },
    "screening": {"type": "object", "required": ["before", "after", "rule_version"]},
    "fit": {"type": "object"},
    "p1401": {"type": "object"},
    "provenance": {"type": "object"},
    "status": {"type": "string", "enum": ["success", "failed"]},
    "report_files": {"type": "array", "items": {"type": "string"}}
  }
}
