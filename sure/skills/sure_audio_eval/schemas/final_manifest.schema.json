{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "task_version", "dataset_version", "audio_version", "created_at", "artifacts", "artifact_count", "provenance"],
  "properties": {
    "schema": {"type": "string", "enum": ["sure.audio_eval.final_manifest.v1"]},
    "task_id": {"type": "string", "minLength": 1},
    "task_version": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "audio_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "path", "sha256"], "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "row_count": {"type": "integer", "minimum": 0}, "schema": {"type": "string"}}}},
    "provenance": {"type": "object"}
  }
}
